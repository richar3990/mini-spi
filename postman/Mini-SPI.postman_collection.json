            "body": {
              "mode": "raw",
              "raw": "{\n    \"sourceAccount\": \"{{sourceAccount}}\",\n    \"destinationAccount\": \"{{destinationAccount}}\",\n    \"amount\": 999999999.00,\n    \"description\": \"Prueba fondos insuficientes\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transferencias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transferencias"
              ]
            },
            "description": "Valida que una transferencia que supera el saldo disponible sea rechazada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error response contains message\", function () {",
                  "    pm.expect(pm.response.json().message).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
